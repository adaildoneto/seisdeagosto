{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "login": true,
  "steps": [
    { "step": "setSiteLanguage", "language": "pt_BR" },
    { "step": "activateTheme", "themeFolderName": "seisdeagosto" },
    { "step": "defineWpConfigConsts", "consts": { "WP_DEBUG": true, "WP_DEBUG_LOG": true, "WP_DEBUG_DISPLAY": false } },
    { "step": "setSiteOptions", "options": { "blogname": "Seis de Agosto (teste)" } }
  ]
}
