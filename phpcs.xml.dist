<?xml version="1.0"?>
<ruleset name="SeisdeAgosto">
    <description>Padrões de código do tema SeisdeAgosto (WordPress Coding Standards).</description>

    <file>.</file>

    <!-- Bibliotecas de terceiros e cópias de templates do WooCommerce. -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/bootstrap/*</exclude-pattern>
    <exclude-pattern>/bootstrap_theme/*</exclude-pattern>
    <exclude-pattern>/components/*</exclude-pattern>
    <exclude-pattern>/slick/*</exclude-pattern>
    <exclude-pattern>/assets/vendor/*</exclude-pattern>
    <exclude-pattern>/woocommerce/*</exclude-pattern>
    <exclude-pattern>/inc/bootstrap/wp_bootstrap4_navwalker.php</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.1"/>

    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress">
        <!-- O tema usa nomes de arquivo herdados do Pinegrow (ex.: wp_pg_helpers.php). -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="u_correio68"/>
                <element value="u_seisbarra8"/>
                <element value="seideagosto"/>
            </property>
        </properties>
    </rule>
</ruleset>
